// ViPER4Android RE AIDL effect driver (prebuilt, v2.1.1), from
// https://github.com/likelikeslike/ViPERFX_RE (GPL-3.0). Controlled by
// the ViPER4Android app through the "viper.control" binder service it
// registers inside the effect HAL.
cc_prebuilt_library_shared {
    name: "libv4a_aidl",
    vendor: true,
    relative_install_path: "soundfx",
    compile_multilib: "64",
    check_elf_files: false,
    strip: {
        none: true,
    },
    arch: {
        arm64: {
            srcs: ["libv4a_aidl.so"],
        },
    },
}

// ViPER4Android app (v2.1.1, prebuilt release from
// likelikeslike/ViPER4Android, GPL-3.0). Installed as a privileged app so
// it gets MODIFY_AUDIO_ROUTING and can use per-app mode without root; it
// keeps the upstream signature, so GitHub releases install as updates.
android_app_import {
    name: "ViPER4Android",
    apk: "ViPER4Android.apk",
    presigned: true,
    preprocessed: true,
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-viper4android.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-viper4android.xml",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-viper4android.xml",
}
