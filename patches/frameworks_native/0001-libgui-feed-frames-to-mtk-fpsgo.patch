 namespace android {

+#ifdef ENABLE_MTK_FPSGO
+// MediaTek perf_ioctl ABI used by mtk_perf_ioctl.ko.
+namespace {
+struct FpsgoPackage {
+    int32_t tid;
+    int32_t value1;
+    uint64_t sfBufferId;
+    int32_t value2;
+    int32_t value3;
+    int32_t queueSf;
+    int32_t api;
+    uint64_t identifier;
+};
+static_assert(sizeof(FpsgoPackage) == 40);
+
+#define FPSGO_IOW(n) _IOW('g', n, FpsgoPackage)
+constexpr unsigned long FPSGO_QUEUE = FPSGO_IOW(1);
+constexpr unsigned long FPSGO_DEQUEUE = FPSGO_IOW(3);
+constexpr unsigned long FPSGO_SWAP_BUFFER = FPSGO_IOW(14);
+constexpr unsigned long FPSGO_CONNECT = FPSGO_IOW(15);
+constexpr unsigned long FPSGO_BQID = FPSGO_IOW(16);
+
+std::mutex gFpsgoIoctlMutex;
+int gFpsgoFd = -1;
+
+bool fpsgoIsHwuiThread() {
+    thread_local const bool isHwui = [] {
+        char name[16]{};
+        return prctl(PR_GET_NAME, name) == 0 && std::strcmp(name, "RenderThread") == 0;
+    }();
+    return isHwui;
+}
+
+void fpsgoNotify(unsigned long request, int32_t value1, uint64_t sfBufferId,
+                 int32_t queueSf, int32_t api, uint64_t identifier) {
+    std::lock_guard lock(gFpsgoIoctlMutex);
+    if (gFpsgoFd == -2) return;
+    if (gFpsgoFd < 0) {
+        gFpsgoFd = open("/proc/perfmgr/perf_ioctl", O_RDONLY | O_CLOEXEC);
+        if (gFpsgoFd < 0) {
+            ALOGW("FPSGO: cannot open perf_ioctl: %s", strerror(errno));
+            gFpsgoFd = -2;
+            return;
+        }
+    }
+    FpsgoPackage package{};
+    package.tid = gettid();
+    package.value1 = value1;
+    package.sfBufferId = sfBufferId;
+    package.queueSf = queueSf;
+    package.api = api;
+    package.identifier = identifier;
+    if (ioctl(gFpsgoFd, request, &package) < 0) {
+        ALOGW("FPSGO: ioctl %#lx failed: %s", request, strerror(errno));
+    }
+}
+} // namespace
+#endif
+
